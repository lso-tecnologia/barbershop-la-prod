# ---- Supabase (Project Settings > API) ----
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
# Use a chave "service_role" (secreta). NUNCA coloque no front-end nem use prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ---- Segurança ----
# String longa e aleatória (ex.: gere com: openssl rand -hex 48)
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
# Chave usada UMA vez na página /api/setup para criar o admin. Depois apague da Vercel.
SETUP_KEY="uma-chave-temporaria-forte"

# ---- Opcionais ----
ADMIN_EMAIL="leo.arruda226@gmail.com"
# Só use "true" em testes: devolve o código de redefinição de senha na resposta da API.
ALLOW_PREVIEW_RESET_TOKEN="false"

# ---- E-mail de recuperação de senha (Resend: https://resend.com) ----
# Para enviar a qualquer cliente é preciso verificar um domínio seu no Resend.
RESEND_API_KEY=""
RESEND_FROM="BARBERSHOP L.A <nao-responda@seudominio.com.br>"

# ---- Mercado Pago (Pix e Cartão) ----
# Mercado Pago > Suas integrações > sua aplicação > Credenciais. Use a de TESTE para testar e a de PRODUÇÃO ao ir ao ar.
MP_ACCESS_TOKEN="APP_USR-..."
# Mercado Pago > Suas integrações > sua aplicação > Webhooks > chave secreta (valida que o aviso veio do Mercado Pago)
MP_WEBHOOK_SECRET=""
# Endereço público do site, sem barra no final (ex.: https://barbershop-la.vercel.app)
SITE_URL="https://SEU-SITE.vercel.app"
