# ---- Supabase (Project Settings > API) ----
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
# Use a chave "service_role" (secreta). NUNCA coloque no front-end nem use prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ---- Segurança ----
# String longa e aleatória (ex.: gere com: openssl rand -hex 48)
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
# Chave usada UMA vez na página /api/setup para criar o admin. Depois apague da Vercel.
SETUP_KEY="uma-chave-temporaria-forte"

# ---- Opcionais ----
ADMIN_EMAIL="leo.arruda226@gmail.com"
# Só use "true" em testes: devolve o código de redefinição de senha na resposta da API.
ALLOW_PREVIEW_RESET_TOKEN="false"
